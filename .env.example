# === Supabase Auth (client-safe) =========================================
# Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service-role key (Settings → API → service_role). SERVER-ONLY.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# === Prisma / Postgres ===================================================
# Settings → Database → Connection string (use the shared pooler).
# Runtime — transaction-mode pooler (pgbouncer, IPv4).
# connect_timeout/pool_timeout give the free-tier DB time to wake from idle.
DATABASE_URL="postgresql://postgres.YOUR-REF:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connect_timeout=20&pool_timeout=20"
# Migrations — session-mode pooler.
DIRECT_URL="postgresql://postgres.YOUR-REF:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:5432/postgres"

# === App URL =============================================================
# Exact public origin. The Google OAuth redirect URI is derived from this
# (never from the request Host header), so it must match the Cloud Console
# entry character for character.
APP_URL=http://localhost:3000

# === Google Drive (optional — large-file uploads) ========================
# Cloud Console → APIs & Services → Credentials → OAuth client ID
# → Application type: "Web application".
# Authorised redirect URI must be exactly: <APP_URL>/api/google/callback
# Scope used: drive.file only (access limited to files this app creates).
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Encrypts the Google refresh token at rest (AES-256-GCM). SERVER-ONLY.
# Generate with:  openssl rand -base64 32
# Rotating this invalidates the stored token — reconnect Drive afterwards.
GOOGLE_TOKEN_ENC_KEY=base64-encoded-32-byte-key

# === Daily reminder emails (optional) =====================================
# See docs/email-reminders.md. Any SMTP mailbox works (Zoho Mail, Google
# Workspace, Brevo, Resend…). 587 = STARTTLS, 465 = implicit TLS.
SMTP_HOST=smtp.zoho.in
SMTP_PORT=587
SMTP_USER=os@fodavin.com
SMTP_PASS=app-specific-password
SMTP_FROM="Fodavin OS <os@fodavin.com>"

# Shared secret the scheduler sends as "Authorization: Bearer …" to
# /api/cron/reminders. SERVER-ONLY. Generate with:  openssl rand -base64 32
CRON_SECRET=long-random-string
