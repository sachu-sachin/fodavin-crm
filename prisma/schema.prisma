// Fodavin Business OS — Prisma schema
// Prisma owns the `public` tables + enums. Supabase-specific wiring (the
// profile sync triggers on auth.users, updated_at triggers, and the lock that
// keeps Supabase's Data API out of these tables: RLS on, no policies, no
// grants) lives in supabase/setup.sql. Re-run it after every schema change.
//
// Field names are kept snake_case to match the DB columns and the app's
// existing domain types (src/lib/types.ts).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// -- Enums (tailored to web / app development work) --------------------------

enum InquiryStage {
  new
  contacted
  proposal_sent
  won
  lost
}

enum InquiryType {
  website
  web_app
  mobile_app
  ecommerce
  branding
  maintenance
  other
}

enum InquirySource {
  referral
  website
  social
  cold_outreach
  marketplace
  repeat_client
  event
  other
}

enum ProjectType {
  website
  web_app
  mobile_app
  ecommerce
  branding
  maintenance
}

enum ProjectPhase {
  discovery
  design
  development
  qa
  launch
  maintenance
}

enum ProjectStatus {
  active
  on_hold
  completed
  archived
}

/// Where a document actually lives. `upload` is a file in the private
/// Supabase Storage bucket; `drive` and `link` are external URLs we only
/// point at (no copy is made, so access stays governed by the source).
enum DocumentSource {
  /// File in the private Supabase Storage bucket (small files).
  upload
  /// File WE uploaded into the agency's Google Drive — we own it and can
  /// delete it. Used for anything above the Supabase size cap.
  drive_upload
  /// A Drive file that already existed; we only store a pointer to it and
  /// must never delete it.
  drive
  link
}

enum DocumentKind {
  proposal
  contract
  invoice
  design
  spec
  handover
  other
}

/// Lifecycle of one payment stage. Invoicing/accounting itself lives in the
/// external books (Zoho Books) — this only tracks what the client owes us.
enum MilestoneStatus {
  pending
  invoiced
  paid
}

enum TaskStatus {
  todo
  in_progress
  review
  done
}

enum TaskType {
  design
  frontend
  backend
  bug
  content
  devops
  general
}

enum TaskPriority {
  low
  medium
  high
  urgent
}

/// A daily stand-up report: the morning plan (after the morning meeting) or
/// the end-of-day update (after the EOD meeting).
enum ReportKind {
  morning
  eod
}

enum SocialPlatform {
  instagram
  facebook
  linkedin
  twitter
  tiktok
  youtube
  other
}

enum PostStatus {
  idea
  draft
  needs_approval
  scheduled
  published
  cancelled
}

enum MeetingType {
  internal
  client
  standup
  review
}

enum AnnouncementCategory {
  general
  policy
  holiday
  event
  urgent
}

enum PostCategory {
  brand_awareness
  services
  educational
  interactive
  fun
  promotion
  testimonial
}

/// One day's attendance status, as in the attendance register. Leave types
/// are statuses too, so a day is exactly one of these.
enum AttendanceStatus {
  present
  absent
  half_day
  work_from_home
  on_duty
  weekly_off
  holiday
  casual_leave
  sick_leave
  earned_leave
  unpaid_leave
  comp_off
  other_leave
}

enum LeaveType {
  casual
  sick
  earned
  unpaid
  comp_off
  other
}

enum LeaveStatus {
  pending
  approved
  rejected
  cancelled
}

// -- Models -------------------------------------------------------------------

model Role {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String        @unique
  /// Super-flag: implies every permission, regardless of the array below.
  /// Guarantees a way back in if a role's permissions are mis-edited.
  is_admin      Boolean       @default(false)
  /// Granted permission strings — see src/lib/permissions.ts for the
  /// catalogue. Unknown values are ignored when the set is expanded.
  permissions   String[]      @default([])
  created_at    DateTime      @default(now()) @db.Timestamptz(6)
  /// People with this as their main role.
  profiles      Profile[]
  /// People holding it as an additional role.
  extra_holders ProfileRole[]

  @@map("roles")
}

/// A role someone holds on top of their main one (Profile.role_id), e.g. a
/// developer who also edits videos. Permissions are the union of all of a
/// person's roles. The main role stays on the profile so the account-creation
/// trigger and anything reading role_id keep working unchanged.
model ProfileRole {
  profile_id String   @db.Uuid
  role_id    String   @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)

  profile Profile @relation(fields: [profile_id], references: [id], onDelete: Cascade)
  role    Role    @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@id([profile_id, role_id])
  @@index([role_id])
  @@map("profile_roles")
}

/// 1:1 with auth.users (FK added in supabase/setup.sql).
model Profile {
  id            String   @id @db.Uuid
  full_name     String?
  email         String?
  avatar_url    String?
  role_id       String?  @db.Uuid
  is_active     Boolean  @default(true)
  /// Receive the daily reminder email. Each person can switch it off.
  email_digest  Boolean  @default(true)
  /// Their managing lead. Leads look after attendance, tasks and daily
  /// reports for the people who report to them.
  reports_to_id String?  @db.Uuid
  created_at    DateTime @default(now()) @db.Timestamptz(6)

  role               Role?              @relation(fields: [role_id], references: [id], onDelete: SetNull)
  extra_roles        ProfileRole[]
  reports_to         Profile?           @relation("ReportsTo", fields: [reports_to_id], references: [id], onDelete: SetNull)
  reportees          Profile[]          @relation("ReportsTo")
  assigned_tasks     Task[]             @relation("TaskAssignee")
  assigned_posts     SocialPost[]       @relation("PostAssignee")
  time_entries       TimeEntry[]
  meetings           MeetingAttendee[]
  announcement_reads AnnouncementRead[]
  /// This person's own onboarding (at most one).
  onboarding         Onboarding?        @relation("OnboardingEmployee")
  digests            DigestLog[]
  attendance         Attendance[]       @relation("AttendanceOf")
  daily_reports      DailyReport[]      @relation("ReportOf")
  leave_requests     LeaveRequest[]     @relation("LeaveOf")

  @@index([role_id])
  @@index([reports_to_id])
  @@map("profiles")
}

model Company {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String
  website    String?
  industry   String?
  /// 15-character GST identification number, needed on Indian invoices.
  gstin      String?
  notes      String?
  created_by String?  @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)

  contacts     Contact[]
  inquiries    Inquiry[]
  projects     Project[]
  social_posts SocialPost[]
  documents    Document[]
  meetings     Meeting[]

  @@map("companies")
}

model Contact {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  company_id String?  @db.Uuid
  full_name  String
  email      String?
  phone      String?
  role_title String?
  notes      String?
  created_by String?  @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)

  company   Company?  @relation(fields: [company_id], references: [id], onDelete: Cascade)
  inquiries Inquiry[]

  @@index([company_id])
  @@map("contacts")
}

model Inquiry {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title          String
  company_id     String?        @db.Uuid
  contact_id     String?        @db.Uuid
  /// Free-text fallback for leads whose contact isn't in the directory yet.
  contact_name   String?
  type           InquiryType    @default(website)
  /// Where the lead came from — drives "which channels actually convert".
  source         InquirySource?
  budget         Decimal?       @db.Decimal(12, 2)
  stage          InquiryStage   @default(new)
  position       Int            @default(0)
  /// Next touchpoint. An open inquiry past this date is an overdue follow-up.
  next_follow_up DateTime?      @db.Date
  /// Why a lead was lost — only meaningful on the `lost` stage.
  lost_reason    String?
  notes          String?
  created_by     String?        @db.Uuid
  created_at     DateTime       @default(now()) @db.Timestamptz(6)
  updated_at     DateTime       @default(now()) @db.Timestamptz(6)

  company  Company?  @relation(fields: [company_id], references: [id], onDelete: SetNull)
  contact  Contact?  @relation(fields: [contact_id], references: [id], onDelete: SetNull)
  projects Project[]

  @@index([stage])
  @@index([company_id])
  @@index([contact_id])
  @@index([next_follow_up])
  @@map("inquiries")
}

model Project {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String
  type             ProjectType   @default(website)
  company_id       String?       @db.Uuid
  /// Set when the project was converted from a won inquiry (quote vs. actual).
  inquiry_id       String?       @db.Uuid
  description      String?
  phase            ProjectPhase  @default(discovery)
  status           ProjectStatus @default(active)
  tech_stack       String[]      @default([])
  repo_url         String?
  staging_url      String?
  production_url   String?
  domain           String?
  registrar        String?
  hosting_provider String?
  /// Renewal dates. A lapsed domain takes the client's site down, so these
  /// drive the dashboard's renewal warnings — and double as a prompt to sell
  /// a maintenance retainer.
  domain_expiry    DateTime?     @db.Date
  hosting_expiry   DateTime?     @db.Date
  budget           Decimal?      @db.Decimal(12, 2)
  start_date       DateTime?     @db.Date
  launch_date      DateTime?     @db.Date
  created_by       String?       @db.Uuid
  created_at       DateTime      @default(now()) @db.Timestamptz(6)
  updated_at       DateTime      @default(now()) @db.Timestamptz(6)

  company      Company?           @relation(fields: [company_id], references: [id], onDelete: SetNull)
  inquiry      Inquiry?           @relation(fields: [inquiry_id], references: [id], onDelete: SetNull)
  tasks        Task[]
  milestones   PaymentMilestone[]
  documents    Document[]
  time_entries TimeEntry[]
  meetings     Meeting[]

  @@index([company_id])
  @@index([inquiry_id])
  @@index([phase])
  @@map("projects")
}

model Task {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  project_id      String?      @db.Uuid
  title           String
  description     String?
  type            TaskType     @default(general)
  status          TaskStatus   @default(todo)
  assignee_id     String?      @db.Uuid
  /// Set when the task is an action item from a meeting. Such a task may have
  /// no project (an internal meeting); it still lives on the normal boards.
  meeting_id      String?      @db.Uuid
  /// Set when the task is an item on someone's onboarding checklist.
  onboarding_id   String?      @db.Uuid
  priority        TaskPriority @default(medium)
  /// Free-text stream of work, e.g. "Meta Ads", "SEO", "Editing".
  workstream      String?
  /// Time the lead allows for it, and the time it actually took.
  allocated_hours Decimal?     @db.Decimal(5, 2)
  actual_hours    Decimal?     @db.Decimal(5, 2)
  /// Set when it first moves to In progress / to Done (cleared if reopened).
  started_at      DateTime?    @db.Timestamptz(6)
  completed_at    DateTime?    @db.Timestamptz(6)
  position        Int          @default(0)
  due_date        DateTime?    @db.Date
  created_by      String?      @db.Uuid
  created_at      DateTime     @default(now()) @db.Timestamptz(6)
  updated_at      DateTime     @default(now()) @db.Timestamptz(6)

  project    Project?    @relation(fields: [project_id], references: [id], onDelete: Cascade)
  assignee   Profile?    @relation("TaskAssignee", fields: [assignee_id], references: [id], onDelete: SetNull)
  /// SetNull, not Cascade: deleting a meeting's record must not silently
  /// delete the work that came out of it.
  meeting    Meeting?    @relation(fields: [meeting_id], references: [id], onDelete: SetNull)
  /// Cascade: the checklist only exists for that onboarding — cancelling it
  /// (say the person never joined) removes its items too.
  onboarding Onboarding? @relation(fields: [onboarding_id], references: [id], onDelete: Cascade)

  @@index([project_id])
  @@index([assignee_id])
  @@index([meeting_id])
  @@index([onboarding_id])
  @@index([status])
  @@map("tasks")
}

/// One row per person per IST day a reminder digest was sent, so a
/// scheduler that fires twice can never email anyone twice.
model DigestLog {
  profile_id String   @db.Uuid
  /// "YYYY-MM-DD" in IST.
  day        String
  /// How many items the email listed.
  item_count Int
  sent_at    DateTime @default(now()) @db.Timestamptz(6)

  profile Profile @relation(fields: [profile_id], references: [id], onDelete: Cascade)

  @@id([profile_id, day])
  @@map("digest_log")
}

/// A reusable onboarding checklist, e.g. "Developer onboarding".
model OnboardingTemplate {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  description String?
  created_by  String?  @db.Uuid
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @default(now()) @db.Timestamptz(6)

  items       OnboardingTemplateItem[]
  onboardings Onboarding[]

  @@map("onboarding_templates")
}

/// One step of a template. Becomes a Task when an onboarding starts.
model OnboardingTemplateItem {
  id                 String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  template_id        String  @db.Uuid
  title              String
  description        String?
  /// Give it to the person being onboarded…
  assign_to_new_hire Boolean @default(false)
  /// …or to this team member (ignored when assign_to_new_hire). Neither
  /// means unassigned.
  assignee_id        String? @db.Uuid
  /// Due this many days after the start date; negative is before day one.
  due_offset_days    Int     @default(0)
  position           Int     @default(0)

  template OnboardingTemplate @relation(fields: [template_id], references: [id], onDelete: Cascade)

  @@index([template_id])
  @@map("onboarding_template_items")
}

/// Someone being onboarded. Its checklist items are ordinary Tasks
/// (Task.onboarding_id), so they show on the boards and dashboards.
model Onboarding {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// One onboarding per person.
  profile_id  String   @unique @db.Uuid
  /// Which template it was created from; kept for reference only.
  template_id String?  @db.Uuid
  start_date  DateTime @db.Date
  created_by  String?  @db.Uuid
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @default(now()) @db.Timestamptz(6)

  profile  Profile             @relation("OnboardingEmployee", fields: [profile_id], references: [id], onDelete: Cascade)
  template OnboardingTemplate? @relation(fields: [template_id], references: [id], onDelete: SetNull)
  tasks    Task[]

  @@map("onboardings")
}

/// A meeting: who was there, what was discussed and decided. Its action items
/// are ordinary Tasks (Task.meeting_id), so they show up on the task boards and
/// the dashboard rather than in a second to-do list nobody checks.
model Meeting {
  id               String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title            String
  type             MeetingType @default(internal)
  starts_at        DateTime    @db.Timestamptz(6)
  duration_minutes Int?
  /// A room, an address or a call link (Meet / Zoom / Teams).
  location         String?
  company_id       String?     @db.Uuid
  project_id       String?     @db.Uuid
  agenda           String?
  notes            String?
  decisions        String?
  created_by       String?     @db.Uuid
  created_at       DateTime    @default(now()) @db.Timestamptz(6)
  updated_at       DateTime    @default(now()) @db.Timestamptz(6)

  company      Company?          @relation(fields: [company_id], references: [id], onDelete: SetNull)
  project      Project?          @relation(fields: [project_id], references: [id], onDelete: SetNull)
  attendees    MeetingAttendee[]
  action_items Task[]

  @@index([starts_at])
  @@index([company_id])
  @@index([project_id])
  @@map("meetings")
}

/// A company-wide notice or policy. Visible to everyone, or only to the roles
/// in `audience_role_ids`, between `publish_at` and `expires_at`.
model Announcement {
  id                String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title             String
  body              String
  category          AnnouncementCategory @default(general)
  /// Pinned ones stay at the top while live.
  pinned            Boolean              @default(false)
  /// Policies people must confirm they've read, not just see.
  requires_ack      Boolean              @default(false)
  /// Empty means everyone. Stale ids (a deleted role) simply match nobody.
  audience_role_ids String[]             @default([]) @db.Uuid
  /// A future time schedules it; it stays hidden from staff until then.
  publish_at        DateTime             @default(now()) @db.Timestamptz(6)
  expires_at        DateTime?            @db.Timestamptz(6)
  created_by        String?              @db.Uuid
  created_at        DateTime             @default(now()) @db.Timestamptz(6)
  updated_at        DateTime             @default(now()) @db.Timestamptz(6)

  reads AnnouncementRead[]

  @@index([publish_at])
  @@map("announcements")
}

/// Who has read (or, for requires_ack, acknowledged) an announcement.
model AnnouncementRead {
  announcement_id String   @db.Uuid
  profile_id      String   @db.Uuid
  read_at         DateTime @default(now()) @db.Timestamptz(6)

  announcement Announcement @relation(fields: [announcement_id], references: [id], onDelete: Cascade)
  profile      Profile      @relation(fields: [profile_id], references: [id], onDelete: Cascade)

  @@id([announcement_id, profile_id])
  @@index([profile_id])
  @@map("announcement_reads")
}

/// Team members attending a meeting. Client-side attendees go in the notes;
/// they aren't accounts in this app.
model MeetingAttendee {
  meeting_id String @db.Uuid
  profile_id String @db.Uuid

  meeting Meeting @relation(fields: [meeting_id], references: [id], onDelete: Cascade)
  profile Profile @relation(fields: [profile_id], references: [id], onDelete: Cascade)

  @@id([meeting_id, profile_id])
  @@index([profile_id])
  @@map("meeting_attendees")
}

/// The single agency Google account that Drive uploads are written to.
///
/// One row, ever (enforced by `singleton`). An admin connects it once via
/// OAuth; every employee's uploads then land in that account's Drive folder,
/// so files survive staff changes instead of living in someone's personal
/// Drive.
///
/// SECURITY: `refresh_token_encrypted` is AES-256-GCM ciphertext, never the
/// raw token. It is read only by server code, never serialised to a client
/// component, and never logged. Losing GOOGLE_TOKEN_ENC_KEY means the token
/// is unrecoverable — which is the intended failure mode.
model GoogleAccount {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Always true; the unique index makes a second row impossible.
  singleton Boolean @unique @default(true)

  email                   String
  refresh_token_encrypted String
  /// Drive folder all uploads are filed under.
  folder_id               String?
  folder_name             String?
  /// Scopes actually granted, so we can warn if Google returns fewer.
  granted_scopes          String?

  connected_by String?  @db.Uuid
  connected_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at   DateTime @default(now()) @db.Timestamptz(6)

  @@map("google_accounts")
}

/// A file or external link attached to a client or a project.
/// Uploads live in the private `documents` Storage bucket and are only ever
/// served through short-lived signed URLs generated by /api/documents/[id].
model Document {
  id     String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name   String
  source DocumentSource
  kind   DocumentKind   @default(other)

  /// Bucket-relative object path. Set only when source = upload.
  storage_path  String?
  /// Absolute URL. Set only when source = drive | link.
  url           String?
  /// Google Drive / Docs file id — parsed out of `url` for linked files, or
  /// returned by the API for files we uploaded.
  drive_file_id String?

  mime_type  String?
  size_bytes Int?

  company_id String? @db.Uuid
  project_id String? @db.Uuid

  notes       String?
  uploaded_by String?  @db.Uuid
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @default(now()) @db.Timestamptz(6)

  company Company? @relation(fields: [company_id], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@index([company_id])
  @@index([project_id])
  @@map("documents")
}

/// Hours one person logged against one project on one day.
///
/// Deliberately project-level, not task-level: the entry grid is
/// projects × days, so a task dimension couldn't be represented in the UI
/// and — going on how timesheets actually get filled in — would mostly sit
/// empty. Combined with Project.budget this yields an effective hourly rate,
/// which is the profitability signal a small agency can act on.
///
/// The (person, project, day) uniqueness makes each grid cell exactly one
/// row, so editing is an upsert rather than an append-and-reconcile.
model TimeEntry {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profile_id String   @db.Uuid
  project_id String   @db.Uuid
  work_date  DateTime @db.Date
  hours      Decimal  @db.Decimal(5, 2)
  note       String?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)

  profile Profile @relation(fields: [profile_id], references: [id], onDelete: Cascade)
  project Project @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@unique([profile_id, project_id, work_date])
  @@index([project_id])
  @@index([work_date])
  @@map("time_entries")
}

/// One payment stage of a project (advance / mid / final / retainer month).
/// Answers "who owes us what" without trying to be an accounting system.
model PaymentMilestone {
  id         String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  project_id String          @db.Uuid
  label      String
  amount     Decimal         @db.Decimal(12, 2)
  status     MilestoneStatus @default(pending)
  /// When the client is expected to pay. Unpaid + past this = chase it.
  due_date   DateTime?       @db.Date
  /// Set automatically when the milestone is marked paid.
  paid_on    DateTime?       @db.Date
  invoice_no String?
  notes      String?
  position   Int             @default(0)
  created_by String?         @db.Uuid
  created_at DateTime        @default(now()) @db.Timestamptz(6)
  updated_at DateTime        @default(now()) @db.Timestamptz(6)

  project Project @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@index([project_id])
  @@index([status])
  @@index([due_date])
  @@map("payment_milestones")
}

/// Internal operations: social media / content planning, scheduling & reminders.
model SocialPost {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title        String
  content      String?
  platform     SocialPlatform @default(instagram)
  category     PostCategory?
  status       PostStatus     @default(idea)
  company_id   String?        @db.Uuid
  assignee_id  String?        @db.Uuid
  scheduled_at DateTime?      @db.Timestamptz(6)
  reminder_at  DateTime?      @db.Timestamptz(6)
  link_url     String?
  notes        String?
  created_by   String?        @db.Uuid
  created_at   DateTime       @default(now()) @db.Timestamptz(6)
  updated_at   DateTime       @default(now()) @db.Timestamptz(6)

  company  Company? @relation(fields: [company_id], references: [id], onDelete: SetNull)
  assignee Profile? @relation("PostAssignee", fields: [assignee_id], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([assignee_id])
  @@index([scheduled_at])
  @@map("social_posts")
}

/// One person's attendance on one IST day: check-in/out times and the day's
/// status. Members check themselves in and out; their lead (or an admin)
/// sets the status, corrects times and adds remarks. One row per person per
/// day, so every edit is an upsert.
model Attendance {
  id         String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profile_id String            @db.Uuid
  work_date  DateTime          @db.Date
  check_in   DateTime?         @db.Timestamptz(6)
  check_out  DateTime?         @db.Timestamptz(6)
  /// Unset with a check-in counts as present.
  status     AttendanceStatus?
  remarks    String?
  /// Set when the leave approval wrote this day, so cancelling that leave
  /// can undo exactly its own days.
  leave_id   String?           @db.Uuid
  /// Who last set the status or times by hand (a lead or admin).
  marked_by  String?           @db.Uuid
  created_at DateTime          @default(now()) @db.Timestamptz(6)
  updated_at DateTime          @default(now()) @db.Timestamptz(6)

  profile Profile       @relation("AttendanceOf", fields: [profile_id], references: [id], onDelete: Cascade)
  leave   LeaveRequest? @relation(fields: [leave_id], references: [id], onDelete: SetNull)

  @@unique([profile_id, work_date])
  @@index([work_date])
  @@index([leave_id])
  @@map("attendance")
}

/// A leave request. The person's lead (or an admin) approves it; approval
/// marks the working days in the range with the matching leave status.
model LeaveRequest {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profile_id    String      @db.Uuid
  type          LeaveType   @default(casual)
  start_date    DateTime    @db.Date
  end_date      DateTime    @db.Date
  /// A half day; only meaningful for single-day leave.
  half_day      Boolean     @default(false)
  reason        String?
  status        LeaveStatus @default(pending)
  decided_by    String?     @db.Uuid
  decided_at    DateTime?   @db.Timestamptz(6)
  decision_note String?
  created_at    DateTime    @default(now()) @db.Timestamptz(6)
  updated_at    DateTime    @default(now()) @db.Timestamptz(6)

  profile Profile      @relation("LeaveOf", fields: [profile_id], references: [id], onDelete: Cascade)
  days    Attendance[]

  @@index([profile_id])
  @@index([status])
  @@map("leave_requests")
}

/// A public holiday or office closure. Not counted as a working day.
model Holiday {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  date       DateTime @unique @db.Date
  name       String
  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@map("holidays")
}

/// Office hours and attendance rules. One row, ever (`singleton`). Missing
/// row means the defaults below.
model WorkSettings {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  singleton          Boolean  @unique @default(true)
  /// "HH:mm", IST.
  shift_start        String   @default("09:00")
  shift_end          String   @default("18:00")
  /// Minutes after shift_start before a check-in counts as late.
  late_grace_minutes Int      @default(10)
  /// Hours beyond this in a day count as overtime.
  standard_hours     Decimal  @default(8) @db.Decimal(4, 2)
  /// Days off each week, 0 = Sunday … 6 = Saturday.
  weekly_offs        Int[]    @default([0])
  /// Daily meetings, "HH:mm" IST: the morning plan is due after the first,
  /// the end-of-day report after the second.
  morning_meeting    String   @default("09:30")
  eod_meeting        String   @default("17:30")
  updated_at         DateTime @default(now()) @db.Timestamptz(6)

  @@map("work_settings")
}

/// One person's morning plan or end-of-day report for one IST day. Re-saving
/// the same day's report edits it (one row per person, day and kind).
model DailyReport {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profile_id   String     @db.Uuid
  report_date  DateTime   @db.Date
  kind         ReportKind
  /// Morning: today's plan.
  plan         String?
  /// EOD: what got done, what's pending (and why), and blockers.
  completed    String?
  pending      String?
  blockers     String?
  /// Morning: the tasks picked for today.
  task_ids     String[]   @default([]) @db.Uuid
  /// First submission time (later edits don't move it).
  submitted_at DateTime   @default(now()) @db.Timestamptz(6)
  updated_at   DateTime   @default(now()) @db.Timestamptz(6)
  /// The lead's comment.
  review_note  String?
  reviewed_by  String?    @db.Uuid
  reviewed_at  DateTime?  @db.Timestamptz(6)

  profile Profile @relation("ReportOf", fields: [profile_id], references: [id], onDelete: Cascade)

  @@unique([profile_id, report_date, kind])
  @@index([report_date])
  @@map("daily_reports")
}
